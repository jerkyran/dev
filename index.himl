<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jerkyran's Vlog</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background: #f0f0f0; }
        header { background: #333; color: #fff; padding: 20px; text-align: center; font-size: 24px; }
        nav { display: flex; justify-content: center; background: #444; padding: 15px; }
        nav a { color: white; margin: 0 15px; text-decoration: none; font-size: 18px; }
        .container { max-width: 900px; margin: auto; padding: 20px; background: white; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .video { text-align: center; margin-bottom: 20px; }
        .about, .blog, .contact { padding: 20px; background: #f9f9f9; margin-top: 20px; border-radius: 8px; }
        .subscribe { text-align: center; margin-top: 20px; }
        .subscribe button { background: #ff0000; color: white; padding: 10px 20px; font-size: 18px; border: none; cursor: pointer; border-radius: 5px; }
        .socials { text-align: center; margin-top: 20px; }
        .socials a { margin: 0 10px; text-decoration: none; color: #444; font-size: 20px; }
    </style>
</head>
<body>
    <header>
        <h1>Jerkyran's Vlog</h1>
    </header>
    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#blog">Blog</a>
        <a href="#contact">Contact</a>
    </nav>
    <div class="container">
        <section id="home" class="video">
            <h2>Latest Video</h2>
            <iframe width="100%" height="400" src="https://www.youtube.com/embed/your_video_id" frameborder="0" allowfullscreen></iframe>
        </section>
        <section class="subscribe">
            <button>Subscribe</button>
        </section>
        <section id="about" class="about">
            <h2>About Me</h2>
            <p>Hi! I'm Jerkyran, and I love sharing my journey through vlogs. Stay tuned for amazing content!</p>
        </section>
        <section id="blog" class="blog">
            <h2>Latest Blog Posts</h2>
            <p>Coming soon...</p>
        </section>
        <section id="contact" class="contact">
            <h2>Contact Me</h2>
            <p>Email: your_email@example.com</p>
        </section>
        <section class="socials">
            <h2>Follow Me</h2>
            <a href="#">Facebook</a>
            <a href="#">Instagram</a>
            <a href="#">Twitter</a>
        </section>
    </div>
</body>
</html>